#include<stdio.h>
#include<stdlib.h>
#include<string.h>
#include<redline/history.h>
#include<readline/readline.h>
#include "history.h"


int main(void)
//display a welcome banner when the shell starts
printf("=======================================");
printf("          shellforge\n");
printf("   A unix style shell written inc\n");
printf("=======================================");

//Initializing History
using_history();

char *line;

while (1)
{
line = readline("shellforge$ ");
if(line == NULL)
{
 printf("\nGoodbye!\n");
 break;
}

if(strlen(line) == 0)
{
 free(line);
 continue;
}
if(strcmp(line, "history") == 0)
{
print_history();
free(
free(line);
}
return 0;

